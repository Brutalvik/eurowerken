{
  "name": "eurowerken",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @eurowerken/erp",
    "dev:erp": "npm run dev -w @eurowerken/erp",
    "dev:customer": "npm run dev -w @eurowerken/customer",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "bash scripts/db-migrate.sh"
  }
}
