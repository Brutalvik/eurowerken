# Copy to .env.local and fill in. .env.local is git-ignored.

# Frontend (Supabase: Project Settings > API Keys). The publishable key is
# public by design; row level security protects the data. Never put the
# secret key (sb_secret_..., formerly service_role) here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Used only by `npm run db:migrate` on your machine, never sent to the
# browser (Vite exposes VITE_ variables only). URL-encode special
# characters in the password (for example @ becomes %40).
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
